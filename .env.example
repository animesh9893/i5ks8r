# ---------- Backend (backend/.env locally, Render environment in prod) ----------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Regex for extra allowed origins (e.g. Netlify deploy previews: https://([a-z0-9-]+--)?<site>\.netlify\.app)
CORS_ORIGIN_REGEX=
# live = fetch from Elexon at startup (falls back to snapshot); snapshot = offline only
DATA_SOURCE=live
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
FORECAST_PUBLISH_FROM=2025-12-29T00:00:00Z
FORECAST_PUBLISH_TO=2026-02-01T00:00:00Z
ACTUALS_DATE_FROM=2026-01-01
ACTUALS_DATE_TO=2026-02-02
# Day-ahead decision time on D-1, Europe/London
DAY_AHEAD_GATE_LOCAL=11:00
MAX_HORIZON_HOURS=48
# Enables POST /api/admin/refresh when set
ADMIN_TOKEN=
# PORT is injected by Render; defaults to 8000

# ---------- Frontend (frontend/.env.local locally; netlify.toml in prod) ----------
VITE_API_BASE_URL=http://localhost:8000
